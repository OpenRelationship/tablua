<lua>
  -- A plant tracker: a database on the computer, a form that adds, buttons that water. Each action changes the
  -- database, and the page comes back to be merged into the one showing.
  local date = require("date")
  page.title = "Plants"

  local d = db.open("data/plants.dbl")
  d:exec("create table if not exists plant (name text primary key, every int not null, watered text)")
  if not d:one("select 1 as x from plant") then
    local today = date.now()
    for _, p in ipairs({ { "Fern", 3, -4 }, { "Monstera", 7, -2 }, { "Basil", 2, -1 }, { "Snake plant", 14, -3 } }) do
      d:exec("insert into plant values (?, ?, ?)", p[1], p[2], date.day(date.add(today, { days = p[3] })))
    end
  end

  function post.add(req)
    local every = tonumber(req.form.every)
    if (req.form.name or "") ~= "" and every and every >= 1 then
      d:exec("insert or replace into plant values (?, ?, null)", req.form.name, math.floor(every))
    end
  end

  function post.water(req)
    d:exec("update plant set watered = ? where name = ?", date.day(date.now()), req.form.name)
  end

  -- days until it wants water: negative when overdue
  local function due_in(p)
    if not p.watered then return 0 end
    return date.diff(date.add(date.parse(p.watered), { days = p.every }), date.parse(date.day(date.now())), "days")
  end

  local function days(n) return n .. (n == 1 and " day" or " days") end
  local plants = d:query("select * from plant order by name")
</lua>
<a href="../" class="mb-4 inline-flex items-center gap-2 text-sm text-muted-foreground"><icon name="sprout"/> Shroomi gallery</a>
<grid cols="3">
  <card class="md:col-span-2" title="Your plants" description="Water them when they ask.">
    {% if #plants == 0 then %}
      <empty title="No plants yet" description="Add one beside the list."/>
    {% end %}
    <ul>
      {% for _, p in ipairs(plants) do local n = due_in(p) %}
        <li class="flex items-center gap-3 border-b border-border py-3 last:border-0">
          <div class="flex size-9 items-center justify-center rounded-full bg-primary/10 text-primary"><icon name="leaf"/></div>
          <div class="flex-1">
            <p class="font-medium">{{ p.name }}</p>
            <p class="text-sm text-muted-foreground">Every {{ p.every }} days · last {{ p.watered or "never" }}</p>
          </div>
          {% if n < 0 then %}<badge variant="destructive">{{ days(-n) }} late</badge>
          {% elseif n == 0 then %}<badge>Today</badge>
          {% else %}<badge variant="outline">in {{ days(n) }}</badge>{% end %}
          <button size="sm" variant="outline" post="water" vals={{ { name = p.name } }}><icon name="droplet"/> Water</button>
        </li>
      {% end %}
    </ul>
  </card>
  <card title="Add a plant">
    <form post="add">
      <input name="name" label="Name" placeholder="Pothos" required/>
      <input name="every" label="Water every (days)" type="number" min="1" value="7"/>
      <button><icon name="plus"/> Add</button>
    </form>
  </card>
</grid>
