<lua>
  -- One example's page, as its agent wrote it.
  local app = string.match(req.query.app or "", "^[a-z]+$") or "plants"
  local file = "apps/" .. app .. "/ui/index.lui"
  local src = fs.read(file) or "not found"
  local _, lines = string.gsub(src, "\n", "")
  page.title = app .. " · Shroomi gallery"
</lua>
<div class="mx-auto max-w-6xl space-y-4 px-4 py-6">
  <a href="./" class="inline-flex items-center gap-2 text-sm text-muted-foreground"><icon name="sprout"/> Shroomi gallery</a>
  <row class="justify-between">
    <h1 class="text-2xl font-semibold">{{ file }}</h1>
    <row>
      <badge variant="secondary">{{ lines }} lines</badge>
      <link_button href="{{ app }}/" size="sm">Open the app</link_button>
    </row>
  </row>
  <pre class="overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm leading-relaxed"><code>{{ src }}</code></pre>
</div>
