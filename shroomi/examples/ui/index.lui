<lua>
  -- The gallery: Shroomi's examples, each an app of this computer under apps/<name>/, written as .lui pages.
  page.title = "Shroomi gallery"
  APPS = {
    { "plants", "Plants", "sprout", "A watering log in a database: add a plant, water it, see what is due." },
    { "notes", "Notes", "notebook-pen", "Markdown notes kept on the computer's disk, with a preview that follows your typing." },
    { "dashboard", "Dashboard", "chart-column", "Figures, a chart made of plain elements, a table and tabs." },
    { "settings", "Settings", "settings", "A form the server checks field by field, with switches and a dialog before anything is lost." },
    { "report", "Report", "file-text", "A finished piece of work: prose from Markdown, figures, a table read from a CSV." },
    { "inbox", "Inbox", "inbox", "A two-pane mail reader: the list stays, the letter opens beside it." },
  }
</lua>
<div class="mx-auto max-w-6xl space-y-6 px-4 py-6">
  <div class="space-y-2">
    <h1 class="flex items-center gap-2 text-3xl font-semibold tracking-tight"><icon name="sprout" size="28"/> Made with Shroomi</h1>
    <p class="max-w-2xl text-muted-foreground">Each of these is an app an agent could write on its own computer: a .lui
      page, HTML with Lua in it, styled by the kit and utility classes, its actions wired by name. Open one, or read
      the page that made it.</p>
  </div>
  <grid cols="3">
    {% for _, a in ipairs(APPS) do %}
      <card title="{{ a[2] }}" description="{{ a[4] }}">
        <div class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary"><icon name={{ a[3] }} size="20"/></div>
        <slot name="footer">
          <row>
            <link_button href="{{ a[1] }}/" size="sm">Open</link_button>
            <link_button href="source?app={{ a[1] }}" size="sm" variant="outline">Read the page</link_button>
          </row>
        </slot>
      </card>
    {% end %}
  </grid>
</div>
